# Copie para config.toml e ajuste. Campos ausentes usam o padrão indicado.

# Domínio público do link (sem https://). Padrão: "localhost".
public_host = "winshare.exemplo.com.br"

# Porta pública (0.0.0.0): só /s/<token>, /viewer e o WebSocket do espectador. Padrão: 8080.
public_port = 8080

# Porta de controle (127.0.0.1): /control e /api/*. Padrão: 7878.
control_port = 7878

# "external" (padrão): o tunnel roda no roteador e aponta para http://<IP-do-PC>:public_port.
# "managed": o app sobe `cloudflared tunnel run` como processo filho (exige tunnel_name).
# "none": sem tunnel, só acesso local.
tunnel = "external"
# tunnel_name = "winshare"

# Senha opcional da sala. Sem a chave, a sala é aberta para quem tiver o link.
# password = "troque-esta-senha"

# Limite de espectadores simultâneos. Padrão: 10.
max_viewers = 10

# Taxa-teto do vídeo em kbps (500 a 50000). Padrão: 3000 (3 Mbps).
video_bitrate_kbps = 3000

# Taxa mínima do vídeo em kbps (>= 300 e menor que video_bitrate_kbps). Padrão: 800 (800 kbps).
video_min_bitrate_kbps = 800

# Intervalo entre keyframes forçados em segundos (1 a 30). Padrão: 5.
keyframe_interval_secs = 5

# Faixa de portas UDP das conexões ICE (encaminhe no roteador). Padrão: 50000-50100.
udp_port_min = 50000
udp_port_max = 50100

# Servidor TURN opcional (para quem não consegue conexão direta). Vai ao navegador do espectador
# junto com o STUN, na mensagem de oferta. Padrão: sem TURN.
# [turn]
# url = "turn:turn.exemplo.com.br:3478"
# username = "usuario"
# credential = "senha"

# TURN efêmero do Cloudflare Realtime (opcional). Recomendado se o IP da WAN é CGNAT.
# O app pede credenciais de 24 h ao iniciar a transmissão e renova a cada 6 h enquanto ela estiver
# ativa. Se a chamada falhar, avisa no log e segue só com STUN/TURN estático.
# Como criar, no painel da Cloudflare: Realtime → TURN → criar uma TURN key. Copie o "Key ID"
# para key_id. Crie um API token com permissão para o Realtime TURN (confira o nome exato da
# permissão no painel) e cole em api_token. O api_token fica só no servidor: nunca vai ao
# espectador nem aparece em logs. Não versione este arquivo com os valores reais.
# [turn_cloudflare]
# key_id = "colar-o-key-id-aqui"
# api_token = "colar-o-token-aqui"
